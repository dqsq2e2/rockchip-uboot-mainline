// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * RK3588 aigo-s60 (rkjump target)
 *
 * 基于 official-rom fdt.dts 精简，只保留 rkjump 热跳转需要的节点：
 *   - UART2 (串口控制台)
 *   - SFC + SPI NOR (启动存储)
 *   - SDHCI (eMMC)
 *   - SDMMC (SD卡)
 *   - SARADC (ADC按键，无 vref-supply 避免PMIC超时)
 *   - CRU/GRF/Pinctrl/GPIO (基础时钟和引脚)
 *
 * 对比 bdy-g98.dts 的主要删减：
 *   - 移除所有 PMIC regulator (vref-supply, I2C regulator chain)
 *   - 移除 ethernet/gmac (rkjump不需要网络)
 *   - 移除 PCIE/SATA/HDMI/音频/IR/LED/Fan
 *   - 移除 u-boot,dm-pre-reloc 标记避免probe超时设备
 *   - saradc 不设 vref-supply（原厂固件同样不设）
 */
/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "rk3588.dtsi"

/ {
	model = "Rockchip RK3588 EVB (aigo-s60 rkjump)";
	compatible = "rockchip,rk3588-evb", "rockchip,rk3588";

	chosen {
		stdout-path = "serial2:1500000n8";
		u-boot,spl-boot-order = "same-as-spl", &spi_nor;
	};

	aliases {
		spi5 = &sfc;
		mmc0 = &sdhci;
		mmc1 = &sdmmc;
	};

	adc-keys {
		compatible = "adc-keys";
		io-channels = <&saradc 1>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <1800000>;
		u-boot,dm-pre-reloc;
		status = "okay";

		volumeup-key {
			u-boot,dm-pre-reloc;
			linux,code = <KEY_VOLUMEUP>;
			label = "volume up";
			press-threshold-microvolt = <1750>;
		};
	};
};

/* ---- SPI Flash (启动存储) ---- */
&sfc {
	status = "okay";
	u-boot,dm-pre-reloc;
	u-boot,dm-spl;
	bootph-all;
	bootph-pre-ram;
	bootph-some-ram;
	pinctrl-names = "default";
	pinctrl-0 = <&fspim0_pins>;
	/delete-node/ flash@1;

	spi_nor: flash@0 {
		u-boot,dm-spl;
		compatible = "jedec,spi-nor";
		label = "sfc_nor";
		reg = <0x00>;
		spi-tx-bus-width = <0x01>;
		spi-rx-bus-width = <0x04>;
		spi-max-frequency = <0x5f5e100>;
		spi-4byte-addressing;
		bootph-all;
		bootph-pre-ram;
		bootph-some-ram;
	};
};

/* ---- eMMC ---- */
&sdhci {
	bus-width = <8>;
	no-sdio;
	no-sd;
	non-removable;
	max-frequency = <200000000>;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	status = "okay";
};

/* ---- SD Card ---- */
&sdmmc {
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	cd-gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_LOW>;
	disable-wp;
	no-mmc;
	no-sdio;
	max-frequency = <200000000>;
	sd-uhs-sdr104;
	status = "okay";
};

/* ---- UART2 (串口控制台) ---- */
&uart2 {
	pinctrl-0 = <&uart2m0_xfer>;
	status = "okay";
};

/* ---- SARADC (ADC按键, 不设 vref-supply 避免PMIC I2C超时) ---- */
&saradc {
	status = "okay";
	u-boot,dm-pre-reloc;
};
